# Copy to .env and adjust. Loaded by mqtt_client.py.

# MQTT broker (optional; defaults shown)
# MQTT_HOST=mqtt.emf.camp
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=

# Effect output: ddp = real dome, simulator = local test (optional; default ddp)
# EFFECT_OUTPUT=ddp

# Override the thunderdome controllers.json (optional; CLI default used if unset)
# THUNDERDOME_CONTROLLERS=/path/to/controllers.json
