; Example Asterisk PJSIP config for the EMF SIP service.
;
; Replace YOUR_EMF_SIP_USERNAME and YOUR_EMF_SIP_PASSWORD before use.
; Depending on the Asterisk installation, merge this into pjsip.conf or include
; it from a local configuration directory.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[dome-emf-auth]
type=auth
auth_type=userpass
username=YOUR_EMF_SIP_USERNAME
password=YOUR_EMF_SIP_PASSWORD

[dome-emf-aor]
type=aor
contact=sip:sip.emf.camp:5060
qualify_frequency=60

[dome-emf-endpoint]
type=endpoint
transport=transport-udp
context=dome-incoming
disallow=all
allow=alaw
allow=g722
allow=ulaw
outbound_auth=dome-emf-auth
aors=dome-emf-aor
from_user=YOUR_EMF_SIP_USERNAME
from_domain=sip.emf.camp
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[dome-emf-identify]
type=identify
endpoint=dome-emf-endpoint
match=sip.emf.camp

[dome-emf-registration]
type=registration
transport=transport-udp
outbound_auth=dome-emf-auth
server_uri=sip:sip.emf.camp
client_uri=sip:YOUR_EMF_SIP_USERNAME@sip.emf.camp
retry_interval=60
expiration=300
