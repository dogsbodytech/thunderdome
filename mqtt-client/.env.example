# Copy to .env and adjust. Loaded by mqtt_client.py.

# MQTT broker (optional; defaults shown)
# MQTT_HOST=mqtt.emf.camp
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=

# thunderdome control serve base URL (optional; default shown)
# CONTROL_URL=http://127.0.0.1:8080

# Force output mode (optional; unset inherits the baseline output or the
# control service's --default-output)
# EFFECT_OUTPUT=ddp

# Seconds a triggered effect runs before the baseline is restored (optional)
# EFFECT_DURATION_SECONDS=120

# Only forward these effects (optional; unset forwards any well-formed name)
# EFFECT_ALLOWLIST=fire,aurora,expanding-rings
